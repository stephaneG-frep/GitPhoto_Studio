<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : aucune donnée de l'application n'est copiée dans la
     sauvegarde cloud ni transférée vers un autre appareil (base locale,
     copies de travail, trousseau chiffré de flutter_secure_storage). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
