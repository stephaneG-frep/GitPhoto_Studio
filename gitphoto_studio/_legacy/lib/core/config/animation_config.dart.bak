/// Configuration des animations pour GitPhoto Studio
/// Centralise tous les paramètres d'animation de l'application

import 'package:flutter/material.dart';

/// Configuration globale des animations
class AnimationConfig {
  // Durées standard
  static const Duration fast = Duration(milliseconds: 150);
  static const Duration normal = Duration(milliseconds: 250);
  static const Duration slow = Duration(milliseconds: 500);
  static const Duration verySlow = Duration(milliseconds: 800);

  // Courbes d'animation
  static const Curve ease = Curves.ease;
  static const Curve easeIn = Curves.easeIn;
  static const Curve easeOut = Curves.easeOut;
  static const Curve easeInOut = Curves.easeInOut;
  static const Curve fastOutSlowIn = Curves.fastOutSlowIn;
  static const Curve bounce = Curves.bounceOut;
  static const Curve elastic = Curves.elasticOut;

  // Sélection multiple
  static const Duration selectionDuration = normal;
  static const Curve selectionCurve = easeInOut;
  static const double selectionScale = 0.95;
  static const Color selectionColor = Colors.blue;
  static const double selectionBorderWidth = 3.0;

  // Hover (survol)
  static const Duration hoverDuration = fast;
  static const double hoverScale = 1.05;

  // Fade In
  static const Duration fadeInDuration = normal;
  static const double fadeInOffset = 20.0;
  static const Curve fadeInCurve = easeOut;

  // Favoris
  static const Duration favoriteDuration = normal;
  static const double favoriteScale = 1.3;
  static const Color favoriteColor = Colors.red;

  // Transitions de page
  static const Duration pageTransitionDuration = normal;
  static const Curve pageTransitionCurve = easeOut;

  // Drag & Drop
  static const Duration dragDropDuration = fast;
  static const Color dragDropHighlightColor = Colors.blue;
  static const double dragDropBorderWidth = 2.0;

  // Feedback
  static const Duration feedbackDuration = Duration(milliseconds: 500);
  static const IconData successIcon = Icons.check_circle;
  static const IconData errorIcon = Icons.error;
  static const IconData infoIcon = Icons.info;
  static const Color successColor = Colors.green;
  static const Color errorColor = Colors.red;
  static const Color infoColor = Colors.blue;

  // Chargement
  static const Duration loadingDuration = Duration(milliseconds: 1000);
  static const Color loadingColor = Colors.blue;

  // Animation IA
  static const Duration aiAnimationDuration = slow;
  static const Color aiPrimaryColor = Colors.deepPurple;
  static const Color aiSecondaryColor = Colors.purple;

  // Animation de la galerie
  static const Duration galleryLoadDuration = slow;
  static const Duration staggeredItemDelay = Duration(milliseconds: 50);

  // Animation de suppression
  static const Duration deleteDuration = normal;
  static const double deleteOpacity = 0.0;
  static const double deleteScale = 0.8;

  // Animation de batch
  static const Duration batchProgressDuration = normal;

  /// Thème des animations - désactivé pour l'instant
  /*
  static ThemeData get theme {
    return ThemeData(
      // Animations de transition
      pageTransitionsTheme: PageTransitionsTheme(
        builders: {
          TargetPlatform.android: CupertinoPageTransitionsBuilder(),
          TargetPlatform.iOS: CupertinoPageTransitionsBuilder(),
          TargetPlatform.linux: FadeUpwardsPageTransitionsBuilder(),
          TargetPlatform.windows: FadeUpwardsPageTransitionsBuilder(),
          TargetPlatform.macOS: FadeUpwardsPageTransitionsBuilder(),
        },
      ),
    );
  }
  */
}

/// Thème personnalisé pour les transitions de page
class CustomPageTransitionsBuilder extends PageTransitionsBuilder {
  @override
  Widget buildTransitions<T>(
    PageRoute<T> route,
    BuildContext context,
    Animation<double> animation,
    Animation<double> secondaryAnimation,
    Widget child,
  ) {
    return FadeTransition(
      opacity: animation,
      child: SlideTransition(
        position: Tween<Offset>(
          begin: const Offset(0, 0.1),
          end: Offset.zero,
        ).animate(animation),
        child: child,
      ),
    );
  }
}

/// Clé pour accéder à la configuration dans le thème
class AnimationKeys {
  static const String selection = 'selection';
  static const String hover = 'hover';
  static const String fadeIn = 'fadeIn';
  static const String favorite = 'favorite';
  static const String dragDrop = 'dragDrop';
  static const String feedback = 'feedback';
  static const String loading = 'loading';
}

/// Extension pour accéder facilement aux animations
class AnimationContext {
  /// Animation de sélection
  static Widget selection(Widget child, bool isSelected, {VoidCallback? onTap}) {
    return AnimatedContainer(
      duration: AnimationConfig.selectionDuration,
      curve: AnimationConfig.selectionCurve,
      decoration: BoxDecoration(
        border: Border.all(
          color: isSelected ? AnimationConfig.selectionColor : Colors.transparent,
          width: isSelected ? AnimationConfig.selectionBorderWidth : 0,
        ),
        borderRadius: BorderRadius.circular(8),
      ),
      child: GestureDetector(
        onTap: onTap,
        child: AnimatedScale(
          duration: AnimationConfig.selectionDuration,
          curve: AnimationConfig.selectionCurve,
          scale: isSelected ? AnimationConfig.selectionScale : 1.0,
          child: child,
        ),
      ),
    );
  }

  /// Animation de hover
  static Widget hover(Widget child, {double scale = 1.05}) {
    return MouseRegion(
      cursor: SystemMouseCursors.click,
      child: AnimatedScale(
        duration: AnimationConfig.hoverDuration,
        scale: scale,
        child: child,
      ),
    );
  }

  /// Animation de fade in
  static Widget fadeIn(Widget child, {int index = 0}) {
    return AnimatedOpacity(
      duration: AnimationConfig.fadeInDuration,
      opacity: 1.0,
      curve: AnimationConfig.fadeInCurve,
      child: Transform.translate(
        offset: Offset(0, index * AnimationConfig.fadeInOffset),
        child: child,
      ),
    );
  }
}

/// Builders d'animation pour ListView/GridView
class StaggeredAnimationBuilder {
  /// Builder avec animations décalées
  static Widget staggeredBuilder(
    BuildContext context,
    int index,
    Widget Function(BuildContext, int) builder,
  ) {
    return AnimatedOpacity(
      duration: AnimationConfig.fadeInDuration,
      opacity: 1.0,
      curve: AnimationConfig.easeOut,
      child: Transform.translate(
        offset: Offset(0, index * 20.0),
        child: builder(context, index),
      ),
    );
  }
}
